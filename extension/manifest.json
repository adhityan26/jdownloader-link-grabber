{
  "manifest_version": 3,
  "name": "Scan Download Link",
  "description": "Pindai link di halaman, cek tujuan redirect, dan salin hasilnya dari panel samping.",
  "version": "1.9.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "sidePanel", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Buka Scan Download Link",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "settings.html",
  "side_panel": { "default_path": "panel.html" }
}
